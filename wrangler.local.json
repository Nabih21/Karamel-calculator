{
  "name": "karamel-calculator",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "DATA_BACKEND": "d1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karamel-local",
      "database_id": "local-only",
      "migrations_dir": "migrations"
    }
  ]
}
